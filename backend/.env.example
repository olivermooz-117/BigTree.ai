# Flask — generate unique random values for deployed environments.
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret

# Comma-separated exact origins; no trailing slash.
# Local Vite frontend:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In production, set this to your deployed frontend origin(s), e.g.
# CORS_ORIGINS=https://your-frontend.example.com

# Database — leave empty for SQLite in development, or use Postgres:
# DATABASE_URL=postgresql://user:pass@localhost:5432/bigtree
DATABASE_URL=

# File uploads
UPLOAD_FOLDER=uploads

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Environment ---
# Set ENV=production on your host only (never in your local .env).
# Production refuses to start without: strong unique secrets (32+ chars),
# a PostgreSQL DATABASE_URL, and https-only CORS_ORIGINS with no trailing slash.
# ENV=production

# --- AI guardrails (optional; defaults shown, 0 disables a rate limit) ---
# AI_TIMEOUT_SECONDS=30
# AI_MAX_OUTPUT_TOKENS=4096
# AI_RATE_LIMIT_PER_MINUTE=10
# AI_RATE_LIMIT_PER_DAY=200

# --- Demo account (opt-in) ---
# `flask seed` creates personas only; `flask seed-demo` creates the demo account.
# In production seed-demo is blocked unless ALLOW_DEMO_SEED=true and DEMO_PASSWORD (12+ chars) are set.
# DEMO_PASSWORD=
# ALLOW_DEMO_SEED=false
