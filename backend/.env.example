# Flask — generate unique random values for deployed environments.
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret

# Comma-separated exact origins; no trailing slash.
# Local Vite frontend:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In production, set this to your deployed frontend origin(s), e.g.
# CORS_ORIGINS=https://your-frontend.example.com

# Database — leave empty for SQLite in development, or use Postgres:
# DATABASE_URL=postgresql://user:pass@localhost:5432/bigtree
DATABASE_URL=

# File uploads
UPLOAD_FOLDER=uploads

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
