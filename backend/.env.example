# Flask
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret

# Database — leave empty for SQLite in dev, or use Postgres:
# DATABASE_URL=postgresql://user:pass@localhost:5432/bigtree
DATABASE_URL=

# File uploads
UPLOAD_FOLDER=uploads
# Max size is set in config (10 MB)

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# CORS (comma-separated if multiple)
# CORS is currently open (*) in code; tighten for production
